# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Application / Client ID (for slash command registration)
DISCORD_CLIENT_ID=your_client_id_here

# Optional: restrict bot to one server (recommended for self-hosted — instant slash commands)
DISCORD_GUILD_ID=

# 32-byte hex key for encrypting stored user tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Optional: legacy setting (turbo timing is handled in code; this is unused)
# TURBO_MULTIPLIER=15
